# hack2l
.venv/
__pycache__/
*.py[cod]
.env
*.egg-info/
.pytest_cache/

# Ruido das rodadas de dev. saidas/final/ NAO e' ignorado de proposito: e' a
# evidencia da rodada que vai pro palco, e a maquina que apresenta e' a outra.
#
# Desde 13/08 cada rodada tem a sua pasta em saidas/rodadas/<data>T<hora>-<commit>/,
# com os artefatos dela dentro, e saidas/rodadas/ULTIMA aponta para a mais
# recente. Tudo isso cai neste `saidas/*` e fica FORA do git de proposito: sao
# dezenas de rodadas de dev por semana. O que vale viaja por copia deliberada
# para saidas/final/<nome>/, com um LEIA.md dizendo o que aquela rodada prova.
saidas/*
!saidas/final/

# Log bruto das rodadas de dev. O log da rodada que vai pro palco e' copiado
# para saidas/final/, que nao e' ignorado -- a maquina que apresenta e' a outra.
logs/

# artefatos/ na raiz e' o LEGADO: as rodadas ate' 13/08 escreviam aqui, e o que
# esta commitado continua sendo a evidencia daquelas rodadas. Rodada nova grava
# em saidas/rodadas/<carimbo>/artefatos/, que ja e' ignorado pela regra acima.
# As tres regras abaixo seguem valendo para o que restou aqui.
artefatos/*selftest*
# estado de execucao por maquina, nao evidencia de acusacao. A rodada final
# commita o seu explicitamente com git add -f se o parecer citar.
artefatos/ambiente.json
artefatos/*docker_quebrado*

# Registro de desfecho das ferramentas: estado de EXECUCAO, nao evidencia de
# acusacao -- mesma classe do ambiente.json. Em rodada de verdade ele nasce
# dentro de saidas/rodadas/<carimbo>/artefatos/ e ja e' ignorado por la; aqui na
# raiz so' aparece como residuo de suite, porque _fecha_chamada serializa o
# dicionario inteiro (igual ao avisos.json) e a ultima chamada real de uma
# rodada de testes despeja junto o que ficou em memoria dos testes anteriores.
artefatos/chamadas.json

# Medicao POR MAQUINA e POR RODADA -- nunca compartilhada. A maquina do Mariano
# mediu "duble" e a do Luis "vivo" no mesmo dia, porque a chave da OpenAI e' por
# maquina. Commitar isto faz o duble de uma sobrescrever o vivo da outra, e a R4
# dispara falso-inconclusivo na maquina do palco.
artefatos/ambiente.json
.repos/
