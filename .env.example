# hack2l / Veredito -- copie para .env e preencha. .env e' gitignored.
#
# NADA DE PORTA OU CAMINHO CHUMBADO NO CODIGO. Este arquivo existe porque o
# build roda em duas maquinas com portas diferentes e a APRESENTACAO e' na
# maquina do Luis. Toda ferramenta le daqui.

# --- a unica coisa sem a qual nada roda ---
ANTHROPIC_API_KEY=

# --- app alvo (o desafio) ---
# Maquina do Mariano: 8010/3010/55432 (5432, 8000 e 3000 estao ocupadas).
# Maquina do Luis:    provavelmente 8000/3000/5432, as padrao.
APP_API_URL=http://localhost:8010
APP_WEB_URL=http://localhost:3010
APP_DB_URL=postgresql://kb:kb@localhost:55432/kb

# pasta do repo do desafio, para read_file / grep / run_tests / prova diferencial
CHALLENGE_REPO=../hack2l-challenge
PR_BRANCH=pr/document-sharing
BASE_BRANCH=main

# --- modelos (doc: modelo em variavel de ambiente) ---
MODEL_PROMOTOR=claude-haiku-4-5-20251001
MODEL_ADVOGADO=claude-opus-5
MODEL_JUIZ=claude-sonnet-5

# --- parametros (dev | rodada final) ---
TOP_N=2
TIMEOUT_ACUSACAO_S=180
MAX_VOLTAS_LOOP=10
TASK_BUDGET_TOKENS=30000
MAX_TOKENS_ADVOGADO=64000
EFFORT=high

# --- traces ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-hack2l-public
LANGFUSE_SECRET_KEY=sk-lf-hack2l-secret
