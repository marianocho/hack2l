# hack2l / Veredito -- copie para .env e preencha. .env e' gitignored.
#
# NADA DE PORTA OU CAMINHO CHUMBADO NO CODIGO. Este arquivo existe porque o
# build roda em duas maquinas com portas diferentes e a APRESENTACAO e' na
# maquina do Luis. Toda ferramenta le daqui.

# --- a unica coisa sem a qual nada roda ---
# (a menos que o motor seja AWS -- ver abaixo)
ANTHROPIC_API_KEY=

# --- QUEM cobra pela chamada de modelo (veredito/motor.py) ---
#
#   auto       (padrao) ha' credencial AWS no ambiente? Bedrock. Senao,
#              API direta -- e o pre-voo diz por que caiu.
#   anthropic  forca a API direta.
#   bedrock    Amazon Bedrock. Servico nativo da AWS, e' onde credito
#              promocional costuma valer.
#   aws        Claude Platform on AWS: operada pela Anthropic sobre infra
#              AWS, paridade de API no mesmo dia, cobranca via AWS
#              Marketplace. Exige ANTHROPIC_AWS_WORKSPACE_ID.
#
# 🚨 O Bedrock NAO tem `task_budget` nem fallback de recusa no servidor.
# O motor remove os dois e o pre-voo imprime o que se perdeu -- degradacao
# conhecida pode, degradacao muda nao. Ver `motor.SEM_NO_BEDROCK`.
#
# ⚠️ FORCAR um motor AWS sem credencial LEVANTA, de proposito: cair calado
# para a API direta faturaria a rodada na conta errada.
VEREDITO_MOTOR=auto

# Necessarios para os motores AWS. A regiao nao tem padrao seguro.
# AWS_REGION=us-east-1
# ANTHROPIC_AWS_WORKSPACE_ID=
# Credencial pela cadeia normal do boto3 (env, perfil, role).
# AWS_PROFILE=

# --- app alvo (o desafio) ---
# Maquina do Mariano: 8010/3010/55432 (5432, 8000 e 3000 estao ocupadas).
# Maquina do Luis:    provavelmente 8000/3000/5432, as padrao.
#
# 🚨 127.0.0.1, NUNCA localhost. Medido em 08/08: 'localhost' resolve ::1
# antes de 127.0.0.1, o Docker publica nos dois, e o caminho IPv6 aceita a
# conexao e nunca responde. Deu 0/8 em localhost e 8/8 em 127.0.0.1, nas
# tres portas. E' ReadTimeout, nao ConnectionRefused: cada chamada pendura o
# timeout inteiro e a acusacao vira INCONCLUSIVO por infraestrutura.
APP_API_URL=http://127.0.0.1:8010
APP_WEB_URL=http://127.0.0.1:3010
APP_DB_URL=postgresql://kb:kb@127.0.0.1:55432/kb

# pasta do repo do desafio, para read_file / grep / run_tests / prova diferencial
CHALLENGE_REPO=../hack2l-challenge
PR_BRANCH=pr/document-sharing
BASE_BRANCH=main

# --- modelos (doc: modelo em variavel de ambiente) ---
MODEL_PROMOTOR=claude-haiku-4-5-20251001
MODEL_ADVOGADO=claude-opus-5
MODEL_JUIZ=claude-sonnet-5

# --- parametros (dev | rodada final) ---
TOP_N=2
TIMEOUT_ACUSACAO_S=180
MAX_VOLTAS_LOOP=10
TASK_BUDGET_TOKENS=30000
MAX_TOKENS_ADVOGADO=64000
EFFORT=high

# --- traces ---
LANGFUSE_HOST=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=pk-lf-hack2l-public
LANGFUSE_SECRET_KEY=sk-lf-hack2l-secret
